{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Default": "Server=127.0.0.1;Port=3306;Database=smarthome;User Id=smarthome_user;Password=CHANGE_ME;TreatTinyAsBoolean=true;"
  },

  "Database": {
    "MySqlServerVersion": "8.0.36",
    "AutoDetectServerVersion": true,
    "ApplyMigrationsOnStartup": false,
    "EnsureCreatedIfNoMigrations": false
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200", "https://localhost:4200" ]
  }
}
